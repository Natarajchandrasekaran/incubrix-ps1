# IncuBrix PS1 — AI Background Music Engine

# === API ===
INCUBRIX_API_HOST=0.0.0.0
INCUBRIX_API_PORT=8000

# === Redis (for Celery background jobs) ===
REDIS_URL=redis://localhost:6379/0

# === Storage (MinIO / S3-compatible) ===
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=incubrix-music
S3_REGION=us-east-1

# === MusicGen Model ===
# Options: facebook/musicgen-small, facebook/musicgen-medium, facebook/musicgen-large
MUSICGEN_MODEL=facebook/musicgen-small

# === Audio Defaults ===
DEFAULT_LOUDNESS_LUFS=-16.0
DEFAULT_SAMPLE_RATE=44100
MAX_DURATION_SECONDS=300

# === Logging ===
LOG_LEVEL=INFO
